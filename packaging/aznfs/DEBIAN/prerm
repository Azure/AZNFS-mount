# --------------------------------------------------------------------------------------------

# Exit on error.
set -e
RED="\e[2;31m"
NORMAL="\e[0m"

if [ "$1" == 'remove' -o "$1" == 'purge' ]; then
	# Verify if any v3 or v4.1 existing mounts are there, warn the user about this.
	existing_mounts_v3=$(cat /opt/microsoft/aznfs/data/mountmap 2>/dev/null | egrep '^\S+' | wc -l)
	existing_mounts_v4=$(cat /opt/microsoft/aznfs/data/mountmapv4 2>/dev/null | egrep '^\S+' | wc -l)
	if [ $existing_mounts_v3 -ne 0 -o $existing_mounts_v4 -ne 0 ]; then
		echo
		echo -e "${RED}There are existing Azure Blob/Files NFS mounts using aznfs mount helper, they will not be tracked!"
		echo -n -e "Are you sure you want to continue? [y/N]${NORMAL} "
		read -n 1 result
		echo
		if [ "$result" != "y" -a "$result" != "Y" ]; then
			echo "Removal aborted!"
			exit 1
		fi
	fi
fi

#
# Stop the watchdogs only when the package is being removed. On upgrade leave them running, so an
# interrupted upgrade cannot leave them disabled. postinst restarts them with the new version.
#
if [ "$1" == 'remove' ]; then
	#
	# KillMode=process keeps the stunnels respawned by aznfswatchdogv4 running when it is stopped, and postrm
	# deletes their files. Kill the whole cgroup first (systemctl kill signals all processes of the unit by
	# default), as stopping it did before KillMode=process.
	#
	systemctl kill aznfswatchdogv4 > /dev/null 2>&1 || true
	systemctl stop aznfswatchdog aznfswatchdogv4 || true
	systemctl disable aznfswatchdog aznfswatchdogv4 || true

	echo "Stopped aznfs watchdog service"
elif [ "$1" == 'upgrade' ]; then
	#
	# Older versions' postinst only "start" the watchdogs, so on downgrade stop them (but keep them
	# enabled) for the older version to actually run.
	#
	current_version=$(dpkg-query -W -f='${Version}' aznfs 2>/dev/null || true)
	if [ -n "$current_version" ] && [ -n "$2" ] && dpkg --compare-versions "$2" lt "$current_version"; then
		systemctl stop aznfswatchdog aznfswatchdogv4 || true
		echo "Stopped aznfs watchdog service for downgrade"
	fi
fi
