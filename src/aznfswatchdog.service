[Unit]
Description= aznfs watchdog for NFSv3 mounts
DefaultDependencies=no
Wants=network-online.target remote-fs-pre.target
After=local-fs.target network-online.target umount.target
Before=remote-fs-pre.target shutdown.target
Conflicts=shutdown.target

[Service]
User=root
Environment="AZNFS_SKIP_UNMOUNT_CLEANUP=0"

ExecStart=/usr/sbin/aznfswatchdog
Restart=always
RestartSec=5

[Install]
WantedBy=nfs-client.target
WantedBy=remote-fs-pre.target